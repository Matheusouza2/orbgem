# Copie este arquivo para o .env da aplicação antes de subir o Compose de produção.
# O MariaDB permanece fora do Docker e deve aceitar conexões do host Docker.

APP_NAME=Orbgem
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.example

DB_CONNECTION=mariadb
DB_HOST=10.0.0.10
DB_PORT=3306
DB_DATABASE=orbgem
DB_USERNAME=orbgem
DB_PASSWORD=altere-esta-senha

RUN_MIGRATIONS=true
REDIS_PASSWORD=altere-esta-senha-redis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=orbgem
REVERB_APP_KEY=gere-uma-chave-reverb
REVERB_APP_SECRET=gere-um-segredo-reverb
REVERB_HOST=ws.seu-dominio.example
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_BIND_PORT=8080
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

BRAPI_BASE_URL=https://brapi.dev
BRAPI_TOKEN=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_KEY=

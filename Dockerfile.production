FROM node:22-alpine AS node

FROM node AS frontend-build

WORKDIR /var/www/html

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

RUN npm run build

FROM php:8.4-fpm-alpine3.24 AS php-build

RUN apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        git \
        unzip \
        freetype-dev \
        icu-dev \
        libjpeg-turbo-dev \
        oniguruma-dev \
        libpng-dev \
        libzip-dev \
        zlib-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath gd intl mbstring opcache pdo_mysql zip \
    && pecl install redis \
    && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./

RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --prefer-dist \
        --optimize-autoloader \
        --no-scripts

COPY . .

RUN php artisan package:discover --ansi \
    && mkdir -p storage/app/private storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/testing storage/framework/views storage/logs bootstrap/cache

FROM php:8.4-fpm-alpine3.24 AS runtime

RUN apk add --no-cache \
        freetype \
        icu-data-full \
        icu-libs \
        libjpeg-turbo \
        oniguruma \
        libpng \
        libzip \
        nginx

COPY --from=php-build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=php-build /var/www/html/ /var/www/html/
COPY --from=frontend-build /var/www/html/public/build/ /var/www/html/public/build/

WORKDIR /var/www/html

RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

COPY docker/nginx/default.conf /etc/nginx/http.d/default.conf
COPY docker/entrypoint.production.sh /usr/local/bin/docker-entrypoint

RUN chmod +x /usr/local/bin/docker-entrypoint \
    && printf '%s\n' \
        'opcache.enable=1' \
        'opcache.validate_timestamps=0' \
        'opcache.memory_consumption=192' \
        'opcache.max_accelerated_files=20000' \
        > /usr/local/etc/php/conf.d/zz-production-opcache.ini

EXPOSE 8000

ENTRYPOINT ["docker-entrypoint"]

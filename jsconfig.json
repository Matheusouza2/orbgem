{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "@/Components/*": ["resources/js/Components/*"],
            "@/Layouts/*": ["resources/js/Layouts/*"],
            "@/Pages/*": ["resources/js/Pages/*"],
            "@/Themes/*": ["resources/js/Themes/*"],
            "@/Services/*": ["resources/js/Services/*"],
            "@/Models/*": ["resources/js/Models/*"],
            "@/Utils/*": ["resources/js/Utils/*"],
            "@/actions/*": ["resources/js/actions/*"],
            "@/routes/*": ["resources/js/routes/*"]
        }
    },
    "include": ["resources/js/**/*.js", "resources/js/**/*.jsx", "resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
